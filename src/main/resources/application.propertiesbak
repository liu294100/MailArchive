# ===============================
# DATASOURCE
# ===============================
# Replace with your actual database connection details
spring.datasource.url=jdbc:mysql://localhost:3306/mail_archive_db?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=123456
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ===============================
# MYBATIS PLUS
# ===============================
# Scan for Mapper interfaces (adjust package if needed)
mybatis-plus.mapper-locations=classpath:/mapper/**/*.xml,classpath*:/org/apollo/mail/mapper/**/*.xml
# Type aliases package for entities (adjust package if needed)
mybatis-plus.type-aliases-package=org.apollo.mail.entity
# Turn on logging for SQL execution in console (useful for debugging)
mybatis-plus.configuration.log-impl=org.apache.ibatis.logging.stdout.StdOutImpl
# Enable camel case to underscore mapping
mybatis-plus.configuration.map-underscore-to-camel-case=true

# ===============================
# SPRING WEB
# ===============================
# Server port (optional, defaults to 8080)
# server.port=8080

# ===============================
# THYMELEAF (Optional customizations)
# ===============================
spring.thymeleaf.cache=false # Disable cache during development
spring.thymeleaf.prefix=classpath:/templates/
spring.thymeleaf.suffix=.html

# ===============================
# SPRING MAIL (Default settings - will be overridden by MailConfigService later)
# ===============================
# These are placeholders; the actual connection will use MailConfig entities
# spring.mail.host=
# spring.mail.port=
# spring.mail.username=
# spring.mail.password=
# spring.mail.protocol=imap
# spring.mail.properties.mail.imap.auth=true
# spring.mail.properties.mail.imap.starttls.enable=true
# spring.mail.properties.mail.imap.starttls.required=true
# spring.mail.properties.mail.smtp.ssl.trust=*

# Log Config
logging.level.org.apollo.mail.mapper=debug

# Mail Archive Config
mail.archive.root-path=d:/archives
mail.archive.content-filename=MailContext.html
mail.archive.use-date-structure=true